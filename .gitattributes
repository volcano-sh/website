# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Text file types - ensure LF line endings and standard diffing
*.md text eol=lf diff=markdown
*.json text eol=lf diff=json
*.yml text eol=lf diff=yaml
*.yaml text eol=lf diff=yaml
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.webmanifest text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.webp binary

# Don't check in lock files as binary
package-lock.json text eol=lf diff=json
