# Cache-control headers for static assets.
# See https://docs.netlify.com/configure-builds/file-based-configuration/#headers

# Webpack build output is content-hashed (e.g. main.c86f3454.js), so it is
# safe to cache indefinitely: a content change always produces a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Landing page images are not content-hashed. Cache them for a week so
# repeat visits stay fast while still picking up occasional replacements.
/img/*
  Cache-Control: public, max-age=604800
